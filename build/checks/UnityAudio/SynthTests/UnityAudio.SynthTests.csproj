<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scratch NUnit project for the Unity-free DSP code (ProceduralSynth, GenerativeMusicBed, GodSimAudioMapping). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;CS1574</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../../Assets/GodSim/Core/Contracts/**/*.cs" />
    <Compile Include="../../../../Assets/GodSim/Unity/Runtime/Audio/ProceduralSynth.cs" />
    <Compile Include="../../../../Assets/GodSim/Unity/Runtime/Audio/GenerativeMusicBed.cs" />
    <Compile Include="../../../../Assets/GodSim/Unity/Runtime/Audio/GodSimAudioMapping.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
