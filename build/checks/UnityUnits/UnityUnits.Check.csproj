<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Isolated compile check for Assets/GodSim/Unity/Runtime/Units + Effects (no Unity editor available).
    Compiles the shared Core contracts, the owned Unity sources and minimal API stubs:
      stubs/UnityEngineStubs.cs  - only the UnityEngine members these files use (Unity 2022.3 / 6 signatures)
      stubs/GodSimApiStubs.cs    - other teams' APIs (GodSimRunner, GodSimCoords, GodSimPalette, MaterialLibrary,
                                   GodSimSettings, GodSim.Core.Composition.GodSimulation)
    Run: cd build/checks/UnityUnits && dotnet build -nologo -v q
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <RootNamespace>GodSim.Unity</RootNamespace>
    <AssemblyName>GodSim.UnityUnits.Check</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/GodSim/Core/Contracts/**/*.cs" />
    <Compile Include="../../../Assets/GodSim/Unity/Runtime/Units/**/*.cs" />
    <Compile Include="../../../Assets/GodSim/Unity/Runtime/Effects/**/*.cs" />
    <Compile Include="stubs/**/*.cs" />
  </ItemGroup>
</Project>
