<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only check for Assets/GodSim/Unity/Runtime/Buildings against Contracts + minimal Unity/peer-team stubs.
       Run: cd build/checks/UnityBuildings && dotnet build -nologo -v q -disable-build-servers -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <AssemblyName>GodSim.UnityBuildings.Check</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/GodSim/Core/Contracts/**/*.cs" />
    <Compile Include="../../../Assets/GodSim/Unity/Runtime/Buildings/**/*.cs" />
    <Compile Include="stubs/PeerTeamStubs.cs" />
    <Compile Include="stubs/UnityEngineStubs.cs" Condition="'$(UnityManagedPath)' == ''" />
  </ItemGroup>
  <!-- Optionally compile the renderer AND importer against an installed Unity Editor without opening a project. -->
  <ItemGroup Condition="'$(UnityManagedPath)' != ''">
    <Compile Include="../../../Assets/GodSim/Editor/BuildingArtImporter.cs" />
    <Reference Include="$(UnityManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="$(UnityManagedPath)/UnityEditor.dll" Private="false" />
  </ItemGroup>
</Project>
