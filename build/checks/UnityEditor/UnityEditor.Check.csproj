<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated compile check of Assets/GodSim/Editor against contracts + Unity/team API stubs (no Unity install needed). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
    <RootNamespace>GodSim.Unity.Editor</RootNamespace>
    <AssemblyName>GodSim.Editor.Check</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/GodSim/Core/Contracts/**/*.cs" />
    <Compile Include="../../../Assets/GodSim/Editor/**/*.cs" />
    <Compile Include="stubs/**/*.cs" />
  </ItemGroup>
</Project>
