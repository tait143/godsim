<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AI behavioural acceptance tests ("what 10/10 civilization AI means"). Runs the FULL simulation through
    GodSimulation, so it references the real GodSim.Core project (every module), plus the Shared fixtures.
    Run: cd build/checks/AIScenarios, then dotnet test (quiet, no build servers)
    Fast subset: filter TestCategory!=Slow (all current tests are Slow)
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AIScenarios.Tests</AssemblyName>
    <RootNamespace>GodSim.Tests.AIScenarios</RootNamespace>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../GodSim.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/GodSim/Tests/EditMode/Shared/**/*.cs" />
    <Compile Include="../../../tests/GodSim.Tests/AIScenarios/**/*.cs" />
  </ItemGroup>
</Project>
